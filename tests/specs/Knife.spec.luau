--!nocheck
local KnifeState = Runtime:Get("ReplicatedStorage/Shared/Combat/KnifeState")

describe("KnifeState", function()
	it("starts with one knife in hand", function()
		local state = KnifeState.new()
		expect(KnifeState.CanAttack(state)).toBe(true)
	end)

	it("a player cannot use a thrown knife before recovery", function()
		local state = KnifeState.new()
		local id = KnifeState.Throw(state)
		expect(id).toBe(1)
		expect(KnifeState.CanAttack(state)).toBe(false)
		expect(KnifeState.Throw(state)).toBeNil()
		expect(KnifeState.Recover(state, id)).toBe(true)
		expect(KnifeState.CanAttack(state)).toBe(true)
	end)

	it("rejects recovery of stale or foreign throw ids", function()
		local state = KnifeState.new()
		local first = KnifeState.Throw(state)
		expect(KnifeState.Recover(state, first + 1)).toBe(false)
		KnifeState.Replace(state)
		local second = KnifeState.Throw(state)
		expect(second).never.toBe(first)
		expect(KnifeState.Recover(state, first)).toBe(false)
		expect(KnifeState.Recover(state, second)).toBe(true)
		expect(KnifeState.Recover(state, second)).toBe(false)
	end)

	it("station replacement returns the superseded knife id", function()
		local state = KnifeState.new()
		local id = KnifeState.Throw(state)
		expect(KnifeState.Replace(state)).toBe(id)
		expect(KnifeState.CanAttack(state)).toBe(true)
		expect(KnifeState.Replace(state)).toBeNil()
	end)
end)
